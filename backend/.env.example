# ── Core ───────────────────────────────────────────────────────────────────────
# Development (SQLite — local file, no setup needed):
DATABASE_URL=sqlite:///./travel_planner.db
# Production (PostgreSQL from Neon — replace with your actual connection string):
# DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# ── CORS ───────────────────────────────────────────────────────────────────────
# Development: leave blank (defaults to localhost)
# Production: set to your Vercel frontend URL
# ALLOWED_ORIGINS=https://your-app.vercel.app

# ── LLM — Itinerary Generation ─────────────────────────────────────────────────
# Primary: Groq (free, 14,400 req/day) — get key at console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Fallback: Gemini — get key at aistudio.google.com/apikey (must start with AIzaSy...)
GEMINI_API_KEY=your_gemini_api_key_here

# ── LLM — Chatbot Fallback ─────────────────────────────────────────────────────
# OpenRouter provides free Llama/Mistral models when Groq is rate-limited
# Get key at openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# ── Maps & Places ──────────────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=your_google_places_key_here

# ── Weather ────────────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=your_openweather_key_here

# ── Live Flight Prices (optional) ─────────────────────────────────────────────
# Amadeus — 2,000 free calls/month. Get keys at developers.amadeus.com/register
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# ── Live Train Schedules (optional) ───────────────────────────────────────────
# eRail.in — completely free. Get key at erail.in/data
ERAIL_API_KEY=
